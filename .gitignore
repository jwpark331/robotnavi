# 올릴 것만 골라 둔다. 나머지(강의 PDF — 저작권, 다른 주제 메모, 옛 데모 demo/·demo_slip/, 압축본)는 이 노트북에만 둔다.
/*
!/.gitignore
!/README.md
!/install_ros2_humble.sh
!/demo_cliff/
!/발표 자료/
!/보이지 않는 계단 — *.md
!/보이지 않는 계단 — 자료 모음 (2026-10-23)/

# 결함 원본은 demo_cliff/results/*_faults/ 와 같은 내용이라 그쪽만 올린다
/보이지 않는 계단 — 자료 모음 (2026-10-23)/결함 원본/

# 빌드 결과는 컴퓨터마다 새로 만든다 (demo_cliff/setup_new_machine.sh)
demo_cliff/ws/build/
demo_cliff/ws/install/
demo_cliff/ws/log/
__pycache__/
*.pyc

# 영상으로 묶기 전 프레임 (중간에 끊긴 회차에만 남아 있다)
demo_cliff/results/**/frames/
